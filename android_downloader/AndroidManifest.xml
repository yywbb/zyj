<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.ldfs.zyjdownload">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:label="作妖记下载" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:icon="@android:drawable/stat_sys_download_done" android:allowBackup="false" android:usesCleartextTraffic="true">
        <activity android:name=".DownloadActivity" android:exported="true" android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <provider android:name=".DownloadActivity$ApkProvider" android:authorities="com.ldfs.zyjdownload.apk"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
